{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// app.config.ts needs env to evaluate; app.json carries the full plugin list.
	"expo": { "config": ["app.json"] },
	"entry": [
		"app.config.ts",
		// #region template:map
		"metro/reactNativeMapsStub.tsx",
		// #endregion template:map
		"scripts/generate-brand-assets.cjs",
		"plugins/*.js",
		".claude/hooks/*.mjs",
	],
	"ignore": [
		// Template helpers not wired into the demo app yet.
		"src/shared/hooks/useUpdates.ts",
		// Generated by `yarn backend:types`; its helper types are for app code to pick up.
		"src/shared/api/supabase/database.types.ts",
		// Barrel kept for forks; app code imports hooks by file.
		"src/shared/hooks/index.ts",
	],
	"ignoreDependencies": [
		// Starter extras: shipped with the template for new apps, not used by the demo.
		"@expo/ui",
		"es-toolkit",
		"expo-document-picker",
		"expo-image-manipulator",
		"expo-image-picker",
		"expo-location",
		"luxon",
		"@types/luxon",
		// Optional native dep of expo-router's header elements (MaskedViewNative).
		"@react-native-masked-view/masked-view",
		// Plugins of @react-native/eslint-config; legacy eslintrc resolves them from the project root.
		"eslint-plugin-eslint-comments",
		"eslint-plugin-ft-flow",
		"eslint-plugin-jest",
		// CLI for the local backend; called from scripts/backend.sh.
		"supabase",
		// Installed ad hoc for scripts/generate-brand-assets.cjs (see its header).
		"sharp",
	],
	"ignoreBinaries": ["eas", "pod"],
	"rules": {
		// Template ships helpers and barrels that generated apps will use.
		"exports": "warn",
		"types": "warn",
		"nsExports": "warn",
		"nsTypes": "warn",
		"duplicates": "warn",
	},
}
