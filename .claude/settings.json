{
	"permissions": {
		"allow": [
			"Bash(yarn ios)",
			"Bash(yarn ios *)",
			"Bash(yarn ios:*)",
			"Bash(yarn iosr*)",
			"Bash(yarn android)",
			"Bash(yarn android *)",
			"Bash(yarn android:*)",
			"Bash(yarn install-pods*)",
			"Bash(npx expo run:ios*)",
			"Bash(npx expo run:android*)",
			"Bash(npx expo prebuild*)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"Bash(git reset*)",
			"Bash(git clean*)",
			"Bash(git restore*)",
			"Bash(git rebase*)",
			"Bash(git commit --amend*)",
			"Bash(git commit -a*)",
			"Bash(git commit --all*)",
			"Bash(git checkout -- *)",
			"Bash(git checkout -f*)",
			"Bash(git checkout .*)",
			"Bash(git switch -f*)",
			"Bash(git switch --discard-changes*)",
			"Bash(git push* +*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push* --force*)",
			"Bash(git push* -f *)",
			"Bash(git push* main*)",
			"Bash(git push*:main*)",
			"Bash(git branch -D*)",
			"Bash(git push* --delete*)",
			"Bash(git commit* --no-verify*)",
			"Bash(git -c core.hooksPath*)",
			"Bash(HUSKY=0 git*)",
			"Bash(export HUSKY=0*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs",
						"timeout": 10
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "compact|resume",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-status.sh",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
						"timeout": 120,
						"statusMessage": "Running quick verification checks"
					}
				]
			}
		]
	}
}
