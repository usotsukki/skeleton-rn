{
	"cli": {
		"version": ">= 16.6.2",
		"appVersionSource": "remote"
	},
	"build": {
		"base": {
			"environment": "development",
			"node": "22.14.0",
			"yarn": "1.22.1",
			"cache": {
				"key": "v2"
			},
			"ios": {
				"image": "latest"
			},
			"android": {
				"image": "latest"
			},
			"env": {
				"EXPO_PUBLIC_ENABLE_DEV_MODE": "true",
				"EXPO_PUBLIC_LOG_DEBUG": "false",
				"EXPO_PUBLIC_LOG_LEVEL": "debug",
				"NODE_ENV": "development",
				"EXPO_PUBLIC_NODE_ENV": "development"
			}
		},
		"development": {
			"extends": "base",
			"developmentClient": true,
			"channel": "development",
			"ios": {
				"simulator": true
			},
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"extends": "base",
			"environment": "production",
			"channel": "production",
			"autoIncrement": true,
			"env": {
				"NODE_ENV": "production",
				"EXPO_PUBLIC_NODE_ENV": "production"
			}
		},
		"prod-apk": {
			"extends": "production",
			"channel": "production",
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
