{
	"expo": {
		"name": "App",
		"slug": "app",
		"version": "1.3.0",
		"icon": "./assets/png/app-icon.png",
		"scheme": "app",
		"newArchEnabled": true,
		"userInterfaceStyle": "dark",
		"experiments": {
			"typedRoutes": true,
			"tsconfigPaths": true,
			"reactCompiler": true
		},
		"ios": {
			"buildNumber": "1.3.0",
			"bundleIdentifier": "com.example.app",
			"backgroundColor": "#1f1e1d",
			"userInterfaceStyle": "dark"
		},
		"android": {
			"package": "com.example.app",
			"versionCode": 53010300,
			"userInterfaceStyle": "dark"
		},
		"web": {
			"bundler": "metro",
			"output": "server"
		},
		"plugins": [
			"@react-native-google-signin/google-signin",
			"expo-apple-authentication",
			"expo-router",
			"expo-localization",
			"@sentry/react-native",
			"expo-image",
			"expo-video",
			"expo-sqlite",
			[
				"expo-system-ui",
				{
					"userInterfaceStyle": "dark",
					"backgroundColor": "#1f1e1d"
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#1f1e1d",
					"image": "./assets/png/image-splash.png",
					"resizeMode": "cover"
				}
			],
			"react-native-maps",
			[
				"expo-build-properties",
				{
					"ios": {
						"useFrameworks": "static"
					}
				}
			],
			[
				"expo-notifications",
				{
					"icon": "./assets/png/logo.png",
					"color": "#1f1e1d",
					"defaultChannel": "default"
				}
			],
			[
				"expo-dev-client",
				{
					"launchMode": "most-recent",
					"addGeneratedScheme": false
				}
			],
			[
				"expo-screen-orientation",
				{
					"initialOrientation": "DEFAULT"
				}
			]
		]
	}
}
