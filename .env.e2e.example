# Copied to .env.e2e (gitignored) by `yarn backend:start`. Used only by Maestro flows (`yarn e2e:sign-in`).
# Defaults are the local stack's seeded user (supabase/seed.sql); they exist only on localhost.
# For a hosted project, put your own test user here and run `yarn e2e:sign-in --hosted`.
E2E_EMAIL="dev@skeleton.test"
E2E_PASSWORD="local-dev-password"
