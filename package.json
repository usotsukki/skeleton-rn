{
	"name": "skeleton",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"packageManager": "yarn@1.22.1",
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		}
	},
	"scripts": {
		"android": "expo run:android",
		"android:prebuild": "expo prebuild -p android",
		"android:rebuild": "run-s android:prebuild android",
		"eas-android": "dotenv -e .env -- eas build --no-wait -e development -p android",
		"eas-android:prod": "dotenv -e .env -- eas build --no-wait -e production -p android --non-interactive",
		"eas-android:prod-apk": "dotenv -e .env -- eas build --no-wait -e prod-apk -p android --non-interactive",
		"eas-ios": "dotenv -e .env -- eas build --no-wait -e development -p ios",
		"eas-ios:prod": "dotenv -e .env -- eas build --no-wait -e production -p ios --auto-submit --non-interactive",
		"eas-deploy:preview": "dotenv -e .env -- eas deploy",
		"eas-deploy:prod": "dotenv -e .env -- eas deploy --prod",
		"eas-update:prod": "dotenv -e .env -- eas update --channel production --environment production --non-interactive --auto",
		"eas-run": "dotenv -e .env -- eas build:run --latest -e development -p",
		"export-server": "expo export -p web && rm -rf ./dist/client",
		"check-unused-deps": "./scripts/check-unused-deps.sh",
		"duplication:check": "jscpd --config jscpd.json",
		"duplication:view": "jscpd --config jscpd.json && open ./cpd/html/index.html",
		"increment-version": "./scripts/bump-version.sh",
		"install-pods": "(cd ios && pod install)",
		"ios": "expo run:ios --no-bundler",
		"iosr": "expo run:ios --no-bundler --configuration release",
		"ios:prebuild": "expo prebuild -p ios",
		"ios:prebuild:clean": "expo prebuild -p ios --clean",
		"ios:rebuild": "run-s ios:prebuild:clean ios",
		"lint": "run-p lint:*",
		"lint-commit": "commitlint --config commitlint.config.js --edit ",
		"lint:format": "prettier --write .",
		"lint:format:check": "prettier --check .",
		"lint:js": "eslint --cache . --quiet",
		"lint:ts": "tsc --skipLibCheck --noEmit",
		"nuke": "./scripts/nuke.sh",
		"postinstall": "patch-package",
		"prepare": "husky",
		"start": "expo start --dev-client",
		"switch-env": "./scripts/switch-env.sh",
		"test": "TZ=UTC jest src",
		"check": "yarn lint && yarn test",
		"test-e2e": "./scripts/run-maestro-tests.sh"
	},
	"dependencies": {
		"@babel/runtime": "^7.25.6",
		"@dev-plugins/react-native-mmkv": "~0.2.0",
		"@gorhom/bottom-sheet": "^5.2.8",
		"@react-native-community/datetimepicker": "8.6.0",
		"@react-native-community/netinfo": "11.5.2",
		"@react-native-google-signin/google-signin": "^16.0.0",
		"@react-native-masked-view/masked-view": "0.3.2",
		"@react-navigation/drawer": "^7.7.2",
		"@react-navigation/native": "^7.1.28",
		"@rn-primitives/popover": "^1.4.0",
		"@rn-primitives/portal": "^1.4.0",
		"@rn-primitives/slot": "^1.4.0",
		"@rn-primitives/switch": "^1.4.0",
		"@sentry/react-native": "~7.11.0",
		"@shopify/flash-list": "2.0.2",
		"@shopify/react-native-skia": "^2.6.2",
		"@supabase/supabase-js": "^2.99.3",
		"@tanstack/query-persist-client-core": "5.90.2",
		"@tanstack/react-form": "^1.28.6",
		"@tanstack/react-query": "5.90.2",
		"clsx": "^2.1.1",
		"es-toolkit": "^1.45.1",
		"expo": "^55.0.0",
		"expo-apple-authentication": "~55.0.8",
		"expo-blur": "~55.0.8",
		"expo-build-properties": "~55.0.9",
		"expo-checkbox": "~55.0.3",
		"expo-clipboard": "~55.0.8",
		"expo-constants": "~55.0.7",
		"expo-crypto": "~55.0.9",
		"expo-dev-client": "~55.0.11",
		"expo-document-picker": "^55.0.12",
		"expo-font": "~55.0.4",
		"expo-haptics": "~55.0.8",
		"expo-image": "~55.0.6",
		"expo-image-manipulator": "~55.0.10",
		"expo-image-picker": "~55.0.11",
		"expo-linear-gradient": "~55.0.8",
		"expo-linking": "~55.0.7",
		"expo-localization": "~55.0.8",
		"expo-location": "^55.1.2",
		"expo-notifications": "~55.0.11",
		"expo-router": "~55.0.4",
		"expo-screen-orientation": "~55.0.8",
		"expo-splash-screen": "~55.0.10",
		"expo-sqlite": "~55.0.11",
		"expo-status-bar": "~55.0.4",
		"expo-system-ui": "~55.0.11",
		"expo-updates": "~55.0.12",
		"expo-video": "~55.0.10",
		"i18next": "^23.15.1",
		"immer": "^10.1.1",
		"intl-pluralrules": "^2.0.1",
		"lucide-react-native": "^1.7.0",
		"luxon": "^3.7.2",
		"nativewind": "^4.1.23",
		"patch-package": "^8.0.0",
		"postinstall-postinstall": "^2.1.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-error-boundary": "^4.0.13",
		"react-i18next": "^15.0.2",
		"react-native": "0.83.2",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-get-random-values": "~1.11.0",
		"react-native-keyboard-controller": "1.20.7",
		"react-native-maps": "1.27.2",
		"react-native-mmkv": "^4.2.0",
		"react-native-nitro-modules": "^0.35.0",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-url-polyfill": "^3.0.0",
		"react-native-web": "^0.21.0",
		"react-native-worklets": "0.7.2",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^3.4.17",
		"zod": "^4.3.6",
		"zustand": "^5.0.3",
		"zustand-slices": "^0.4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.27.1",
		"@babel/preset-env": "^7.27.2",
		"@commitlint/cli": "^19.5.0",
		"@commitlint/config-conventional": "^19.5.0",
		"@commitlint/format": "^19.5.0",
		"@react-native/eslint-config": "^0.75.3",
		"@testing-library/jest-native": "^5.4.3",
		"@testing-library/react-native": "^13.2.0",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/jest": "^29.5.13",
		"@types/luxon": "^3.7.1",
		"@types/react": "~19.2.10",
		"@types/react-test-renderer": "^19.1.0",
		"@typescript-eslint/eslint-plugin": "^8.7.0",
		"@typescript-eslint/parser": "^8.7.0",
		"babel-jest": "^29.7.0",
		"babel-plugin-transform-import-meta": "^2.3.2",
		"conventional-changelog-atom": "^5.0.0",
		"dotenv-cli": "^7.4.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-babel-module": "^5.3.2",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-i18next": "^6.1.0",
		"eslint-plugin-import": "^2.30.0",
		"eslint-plugin-jest": "^28.8.3",
		"eslint-plugin-jsx-a11y": "^6.10.0",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-testing-library": "^6.3.0",
		"globals": "^15.9.0",
		"husky": "^9.1.6",
		"jest": "^29.7.0",
		"jest-expo": "~55.0.9",
		"jscpd": "^4.0.5",
		"lint-staged": "^15.2.10",
		"npm-run-all": "^4.1.5",
		"prettier": "3.3.3",
