{
	"name": "expo-app",
	"version": "1.0.0",
	"license": "MIT",
	"private": true,
	"main": "expo-router/entry",
	"engines": {
		"node": ">=22.13"
	},
	"packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42",
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		}
	},
	"scripts": {
		"android": "expo run:android",
		"android:prebuild": "expo prebuild -p android",
		"android:rebuild": "run-s android:prebuild android",
		"check": "yarn lint && yarn test",
		"duplication:check": "jscpd --config jscpd.json",
		"duplication:view": "jscpd --config jscpd.json && open ./cpd/html/index.html",
		"eas-android": "dotenv -e .env -- eas build --no-wait -e development -p android",
		"eas-android:prod": "dotenv -e .env -- eas build --no-wait -e production -p android --non-interactive",
		"eas-android:prod-apk": "dotenv -e .env -- eas build --no-wait -e prod-apk -p android --non-interactive",
		"eas-deploy:preview": "dotenv -e .env -- eas deploy",
		"eas-deploy:prod": "dotenv -e .env -- eas deploy --prod",
		"eas-ios": "dotenv -e .env -- eas build --no-wait -e development -p ios",
		"eas-ios:prod": "dotenv -e .env -- eas build --no-wait -e production -p ios --auto-submit --non-interactive",
		"eas-run": "dotenv -e .env -- eas build:run --latest -e development -p",
		"eas-update:prod": "dotenv -e .env -- eas update --channel production --environment production --non-interactive --auto",
		"export-server": "expo export -p web && rm -rf ./dist/client",
		"fix": "prettier --cache --write . && eslint --cache --fix .",
		"increment-version": "./scripts/bump-version.sh",
		"install-pods": "(cd ios && pod install)",
		"ios": "expo run:ios --no-bundler",
		"ios:prebuild": "expo prebuild -p ios",
		"ios:rebuild": "run-s ios:prebuild ios",
		"iosr": "expo run:ios --no-bundler --configuration Release",
		"lint": "run-p 'lint:*'",
		"lint-commit": "commitlint --config commitlint.config.js --edit ",
		"lint:format": "prettier --cache --check .",
		"lint:js": "eslint --cache . --max-warnings=0",
		"lint:ts": "tsc --noEmit",
		"lint:unused": "knip",
		"nuke": "./scripts/nuke.sh",
		"postinstall": "patch-package",
		"e2e:sign-in": "dotenv -e .env -e .env.e2e --no-expand -- ./scripts/e2e-sign-in.sh",
		"eas-build-pre-install": "corepack enable && corepack prepare yarn@4.14.1 --activate",
		"prepare": "husky",
		"start": "expo start --dev-client",
		"switch-env": "./scripts/switch-env.sh",
		"test": "TZ=UTC jest src",
		"test:coverage": "TZ=UTC jest src --coverage"
	},
	"dependencies": {
		"@babel/runtime": "^7.25.6",
		"@dev-plugins/react-native-mmkv": "~0.2.0",
		"@expo/ui": "~57.0.20",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-community/datetimepicker": "9.1.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-google-signin/google-signin": "^16.1.5",
		"@react-native-masked-view/masked-view": "0.3.2",
		"@rn-primitives/popover": "^1.4.0",
		"@rn-primitives/portal": "^1.4.0",
		"@rn-primitives/switch": "^1.4.0",
		"@sentry/react-native": "~7.11.0",
		"@shopify/flash-list": "2.0.2",
		"@shopify/react-native-skia": "^2.6.2",
		"@supabase/supabase-js": "^2.117.2",
		"@tanstack/query-sync-storage-persister": "5.104.0",
		"@tanstack/react-form": "^1.28.6",
		"@tanstack/react-query": "5.104.0",
		"@tanstack/react-query-persist-client": "5.104.0",
		"clsx": "^2.1.1",
		"es-toolkit": "^1.45.1",
		"expo": "^57.0.25",
		"expo-apple-authentication": "~57.0.2",
		"expo-application": "~57.0.3",
		"expo-blur": "~57.0.3",
		"expo-build-properties": "~57.0.22",
		"expo-checkbox": "~57.0.0",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.19",
		"expo-crypto": "~57.0.3",
		"expo-dev-client": "~57.0.19",
		"expo-device": "~57.0.2",
		"expo-document-picker": "~57.0.2",
		"expo-font": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"expo-image-manipulator": "~57.0.20",
		"expo-image-picker": "~57.0.20",
		"expo-linear-gradient": "~57.0.2",
		"expo-linking": "~57.0.11",
		"expo-localization": "~57.0.2",
		"expo-location": "~57.0.20",
		"expo-notifications": "~57.0.21",
		"expo-router": "~57.0.23",
		"expo-screen-orientation": "~57.0.2",
		"expo-splash-screen": "~57.0.9",
		"expo-sqlite": "~57.0.3",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"expo-updates": "~57.0.23",
		"expo-video": "~57.0.5",
		"i18next": "^23.15.1",
		"immer": "^10.1.1",
		"intl-pluralrules": "^2.0.1",
		"lucide-react-native": "^1.48.0",
		"luxon": "^3.7.2",
		"nativewind": "4.2.7",
		"patch-package": "^8.0.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-error-boundary": "^4.0.13",
		"react-i18next": "^15.0.2",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-maps": "1.27.2",
		"react-native-mmkv": "^4.3.2",
		"react-native-nitro-modules": "^0.35.10",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-url-polyfill": "^3.0.0",
		"react-native-web": "^0.21.0",
		"react-native-worklets": "0.10.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^3.4.17",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@commitlint/cli": "^19.5.0",
		"@commitlint/config-conventional": "^19.5.0",
		"@commitlint/format": "^19.5.0",
		"@react-native/eslint-config": "^0.86.3",
		"@react-native/jest-preset": "0.86.3",
		"@testing-library/react-native": "^13.2.0",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/jest": "^29.5.13",
		"@types/luxon": "^3.7.1",
		"@types/react": "~19.2.10",
		"@types/react-test-renderer": "^19.1.0",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"conventional-changelog-atom": "^5.0.0",
		"dotenv-cli": "^7.4.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-ft-flow": "^3.0.11",
		"eslint-plugin-i18next": "^6.1.0",
		"eslint-plugin-import": "^2.30.0",
		"eslint-plugin-jest": "^28.8.3",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-testing-library": "^6.3.0",
		"husky": "^9.1.6",
		"jest": "^29.7.0",
		"jest-expo": "~57.0.5",
		"jscpd": "^4.0.5",
		"knip": "^6.38.0",
		"lint-staged": "^15.2.10",
		"npm-run-all": "^4.1.5",
		"prettier": "3.3.3",
		"prettier-plugin-merge": "^0.7.1",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"react-test-renderer": "19.2.3",
		"typescript": "~6.0.3"
	}
}
