{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "react-native",
		// TS 6 no longer auto-includes @types/*; lib comes from expo/tsconfig.base (DOM + ESNext).
		"types": ["jest", "node"],
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"module": "Preserve",
		"target": "ESNext",
		"paths": {
			"@app/*": ["./src/*"],
			"@assets/*": ["./assets/*"]
		}
	},
	"exclude": ["node_modules", "ios", "android"],
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"commitlint.config.js",
		"metro.config.js",
		"jest.config.js",
		"babel.config.js",
		".lintstagedrc.mjs",
		".eslintrc.js",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts"
	]
}
