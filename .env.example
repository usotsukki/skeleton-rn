# Copy to .env (uncommitted): cp .env.example .env
# Every variable is described in docs/environment.md. Empty values fall back to app.json or are off.
# `yarn backend:start` writes the local Supabase URL and key to .env.local, which outranks this file.

# --- App ---
# development | testing | production (production enforces env.rules.json)
EXPO_PUBLIC_NODE_ENV=development
EXPO_PUBLIC_ENABLE_DEV_MODE=false
# Identity overrides; leave empty to use app.json (set by `yarn setup` / `yarn rename`).
EXPO_PUBLIC_APP_NAME=
EXPO_PUBLIC_APP_SLUG=
EXPO_PUBLIC_APP_SCHEME=
EXPO_PUBLIC_IOS_BUNDLE_ID=
EXPO_PUBLIC_IOS_BUNDLE_ID_TESTING=
EXPO_PUBLIC_ANDROID_PACKAGE=
EXPO_PUBLIC_ANDROID_PACKAGE_TESTING=

# --- EAS (eas init) ---
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_OWNER=
# Apple Developer Team ID, required for production iOS builds.
APPLE_TEAM_ID=

# --- Supabase (hosted project; local development uses .env.local) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Sign-In (one Google Cloud project for every client) ---
# Web client: Android shows the Google button only when it is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client (…apps.googleusercontent.com), not the reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Google Maps (Map demo; removed with `yarn setup --remove map`) ---
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# --- Sentry (empty DSN = no error reporting; no token = no source-map upload) ---
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog (empty token = analytics and feature flags off) ---
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Defaults to https://eu.i.posthog.com; use https://us.i.posthog.com for US cloud.
EXPO_PUBLIC_POSTHOG_HOST=

# --- Logging and your own API (exported from src/shared/env, unused by the demo) ---
EXPO_PUBLIC_LOG_DEBUG=false
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_BASE_API_URL=

# --- Expo CLI ---
# Skip the "uncommitted changes" prompt before prebuild.
EXPO_NO_GIT_STATUS=1
# Open dev builds directly instead of the Expo Go / dev client chooser page.
EXPO_NO_REDIRECT_PAGE=1