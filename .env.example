# Copy to .env (gitignored). Everything here is optional for a local run:
# app identity falls back to app.json, and `yarn backend:start` writes the Supabase values to .env.local.
# Quote values that contain spaces. Full variable list: readme.md → Environment.

EXPO_PUBLIC_NODE_ENV="development"

# App identity (defaults: app.json)
EXPO_PUBLIC_APP_NAME=""
EXPO_PUBLIC_APP_SLUG=""
EXPO_PUBLIC_APP_SCHEME=""
EXPO_PUBLIC_IOS_BUNDLE_ID=""
EXPO_PUBLIC_ANDROID_PACKAGE=""

# Hosted Supabase project. Leave empty to use the local stack (.env.local wins while it runs).
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
